{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "nodenext",
    "target": "es6",
    "jsx": "react-jsx",
    "allowJs": true,
    "sourceMap": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "nodenext"
  },
  "include": [
    "src",
    "src/declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.e2e.ts"
  ],
  "paths": {
    "@components/*": "src/UIComponents/*"
  }
}